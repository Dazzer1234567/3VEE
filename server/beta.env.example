# Copy to /etc/masterdaw-beta.env on the server (root-only, never commit the real one).
# No comments at the end of a line: systemd would read them as part of the value.
BETA_DB=/srv/masterdaw-beta/beta.db
# One folder per platform: windows/ mac/ linux/ -- the newest file in each is served.
BETA_FILES_DIR=/srv/masterdaw-beta/downloads
BETA_BASE_URL=https://3vee.app
BETA_TOKEN_DAYS=7
# downloads allowed per emailed link
BETA_MAX_USES=3
# nginx sends the file itself (internal location /_beta_files/)
BETA_ACCEL=1

# Outgoing mail. Leave SMTP_HOST empty to print emails to the log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=MASTERDAW <support@3vee.app>

# The program's tooltips: the developer's build uploads with this (POST /api/tips).
TIPS_SECRET=
